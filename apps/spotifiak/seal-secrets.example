# Génère apps/spotifiak/sealed-secret.yaml (chiffré pour le cluster : committable).
# À lancer depuis la racine de homelab-k8s, avec kubeseal et l'ARL deemix sous la main.
# SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET : optionnels (import Spotify), à ajouter
# avec --from-literal de la même façon.
PG_PASSWORD=$(openssl rand -hex 24)
read -rsp 'ARL deemix : ' DEEMIX_ARL; echo
kubectl create secret generic spotifiak-secrets -n spotifiak --dry-run=client -o yaml \
  --from-literal=POSTGRES_PASSWORD="$PG_PASSWORD" \
  --from-literal=DATABASE_URL="postgresql://spotifiak:$PG_PASSWORD@spotifiak-postgres:5432/spotifiak" \
  --from-literal=DEEMIX_ARL="$DEEMIX_ARL" \
  | kubeseal --controller-namespace kube-system --controller-name sealed-secrets-controller -o yaml \
  > apps/spotifiak/sealed-secret.yaml
